        <item>
            <title>Version 0.9.5</title>
            <pubDate>Thu, 09 Jul 2026 10:37:24 +0000</pubDate>
            <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
            <description><![CDATA[Force RGB now shows a clear Keep or Revert prompt, so it no longer reverts without warning. The Automation settings are no longer hidden behind the status bar, and you can expand any section by clicking its title, not just the arrow.]]></description>
            <enclosure url="https://github.com/CorvusDevs/CorvusDisplay/releases/download/v0.9.5/CorvusDisplay-0.9.5.zip" sparkle:version="6" sparkle:shortVersionString="0.9.5" sparkle:edSignature="sgMUD4j/qni8Vh9Dy8d44ZROKTBdmHz7gYeOKH9gzTxS0ibRgcN5SR7DH/yq/Opfc/ehY7xtWuCzC3u2CF59Cg==" length="7964987" type="application/octet-stream" />
        </item>
        <item>
            <title>Version 0.9.4</title>
            <pubDate>Fri, 03 Jul 2026 18:19:05 +0000</pubDate>
            <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
            <description><![CDATA[Fixes the brief dimming blink when a video goes full screen. Sub-zero dimming now rides the display gamma pipeline, which survives Space transitions, and automatically falls back to the HDR-safe overlay while HDR content or XDR boost is active.]]></description>
            <enclosure url="https://github.com/CorvusDevs/CorvusDisplay/releases/download/v0.9.4/CorvusDisplay-0.9.4.zip" sparkle:version="5" sparkle:shortVersionString="0.9.4" sparkle:edSignature="EhZe9QD8grVQky8iMmch57RG/a0SQTHROqe/VEYM+jg+6D0qwsikmYgRkjgb0DUi6LKxOKF3cNisUFVKYpDzDw==" length="7959349" type="application/octet-stream" />
        </item>
        <item>
            <title>Version 0.9.3</title>
            <pubDate>Mon, 29 Jun 2026 06:14:21 +0000</pubDate>
            <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
            <description><![CDATA[A big refresh of the menu bar and Advanced Settings. Per-display controls (brightness, color, resolution, layout) now live in one card. The Sleep Timer is redesigned with custom durations, a progress bar, and an Extend menu. Automation is grouped into collapsible sections, with a new Power and Comfort settings area. Larger tap targets in the menu bar, masked license and server keys, and clearer Presets with summaries.]]></description>
            <enclosure url="https://github.com/CorvusDevs/CorvusDisplay/releases/download/v0.9.3/CorvusDisplay-0.9.3.zip" sparkle:version="4" sparkle:shortVersionString="0.9.3" sparkle:edSignature="4XgsCbdj079JVXLilrn/GZiVFyvno63LPMN8xHcmMQxifl0+ez1zZjUf7BnEKKrLrTEkQV3LhGEhlSc+jyFGCg==" length="7959424" type="application/octet-stream" />
        </item>
